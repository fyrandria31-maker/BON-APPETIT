rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function room(r) { return get(/databases/$(database)/documents/rooms/$(r)).data; }
    function mineOrOnly(keys) { return resource.data.uid == me() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    match /users/{u} {
      allow read: if signed();
      allow write: if signed() && me() == u;
    }
    match /wall/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow update: if signed() && mineOrOnly(['n']);
      allow delete: if signed() && resource.data.uid == me();
    }
    match /news/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow update: if signed() && mineOrOnly(['re']);
      allow delete: if signed() && resource.data.uid == me();
      match /c/{cid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.uid == me();
        allow update: if signed() && mineOrOnly(['re']);
        allow delete: if signed() && resource.data.uid == me();
      }
    }
    match /req/{id} {
      allow read: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && resource.data.to == me();
      allow delete: if signed() && (resource.data.from == me() || resource.data.to == me());
    }
    match /rooms/{r} {
      allow get: if signed();
      allow list: if signed() && me() in resource.data.members;
      allow create: if signed() && request.resource.data.admin == me() && me() in request.resource.data.members;
      allow update: if signed() && (resource.data.admin == me() || (me() in resource.data.members && !(me() in request.resource.data.members) && resource.data.members.hasAll(request.resource.data.members)));
      allow delete: if signed() && (resource.data.admin == me() || (resource.data.type == 'dm' && me() in resource.data.members));
      match /msgs/{m} {
        allow read: if signed() && me() in room(r).members;
        allow create: if signed() && me() in room(r).members && request.resource.data.uid == me();
        allow update: if signed() && me() in room(r).members && mineOrOnly(['re']);
        allow delete: if signed() && (resource.data.uid == me() || room(r).admin == me());
      }
      match /join/{u} {
        allow read: if signed();
        allow create: if signed() && me() == u;
        allow delete: if signed() && (me() == u || room(r).admin == me());
      }
    }
  }
}
